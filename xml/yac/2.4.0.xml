 <name>yac</name>
 <channel>pecl.php.net</channel>
 <summary>lockless user data cache</summary>
 <description>yac is a fast, lock-free, shared memory user data cache for PHP. it can be used to replace APC or local memcached.</description>
 <lead>
  <name>Xinchen Hui</name>
  <user>laruence</user>
  <email>laruence@php.net</email>
  <active>yes</active>
 </lead>
 <date>2026-08-27</date>
